{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snag",
  "version": "0.1.0",
  "identifier": "com.streamdrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"snag","width":1280,"height":820,"minWidth":900,"minHeight":620,"dragDropEnabled":false}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {"../engine/":"engine/","../extension/":"extension/"},
    "icon": ["icons/icon.png","icons/icon.ico"],
    "windows": {"nsis":{"installMode":"currentUser","languages":["Korean","English"]}}
  }
}
