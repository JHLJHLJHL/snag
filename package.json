{
  "name": "snag",
  "productName": "snag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "크롬에서 발견한 영상을 로컬 다운로드 큐로",
  "scripts": {
    "dev": "node scripts/rust.mjs tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
