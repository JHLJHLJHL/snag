{
  "manifest_version": 3,
  "name": "snag",
  "version": "0.1.0",
  "description": "공개 영상을 찾아 로컬 다운로드 큐에 추가합니다.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "snag",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}